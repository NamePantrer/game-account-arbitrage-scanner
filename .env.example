# Lolz Market API (https://lzt.market/account/api)
LZT_API_TOKEN=
LZT_BALANCE_ID=

# FunPay — cookie golden_key (DevTools → Application → Cookies → funpay.com)
# Для скана лотов НЕ обязателен (публичные /lots/). Нужен для кабинета/покупок.
FUNPAY_GOLDEN_KEY=

# PlayerOK — cookie token (JWT) с .playerok.com
# DevTools → Application → Cookies → .playerok.com → token
# Без токена GraphQL недоступен. При BotCheck — добавь __ddg5_ / полный Cookie.
PLAYEROK_TOKEN=
PLAYEROK_DDG5=
PLAYEROK_COOKIES=
PLAYEROK_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/146.0.0.0 Safari/537.36

# Автопокупка (Lolz fast-buy после скана)
AUTOBUY_ENABLED=false
AUTOBUY_DRY_RUN=true

# Minimum net profit in RUB
MIN_PROFIT_RUB=50

# Minimum profit margin %
MIN_MARGIN_PERCENT=8

# Scan interval in minutes (background auto-scan)
SCAN_INTERVAL_MINUTES=15

# Опционально: PIN для входа в дашборд (если задан — страница /login)
DASHBOARD_TOKEN=
